# Copy to .env in this directory and fill in values (do not commit .env).
LABEL_STUDIO_API_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Project 27 / tab 34 from the Data Manager URL (…/data?tab=34)
LABEL_STUDIO_EXPORT_VIEW_ID=34
LABEL_STUDIO_EXPORT_ANNOTATED_ONLY=1
LABEL_STUDIO_EXPORT_FINISHED_ONLY=1

